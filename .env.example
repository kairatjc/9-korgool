# Скопируйте в .env на сервере (docs/deploy.md).
# Домен, на который указывает A-запись DNS. Caddy сам получит HTTPS-сертификат.
DOMAIN=9-korgool.kg

# Пароль PostgreSQL и секрет подписи сессий. Сгенерируйте каждый: openssl rand -hex 32
# (только буквы и цифры: пароль подставляется в строку подключения).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Sentry — необязательно. Пусто — ошибки никуда не отправляются.
SENTRY_DSN=
# DSN для браузера (можно тот же проект). Применяется при сборке образа web.
VITE_SENTRY_DSN=
