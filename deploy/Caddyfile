# Один домен: статика клиента и сервер партий (docs/deploy.md).
# DOMAIN задаётся в .env; для локальной проверки — DOMAIN=localhost.
{$DOMAIN} {
	encode zstd gzip

	# Сервер партий: Socket.IO (WebSocket и long-polling) и проверка здоровья.
	handle /socket.io/* {
		reverse_proxy server:3000
	}
	handle /health {
		reverse_proxy server:3000
	}

	# Клиент (SPA): файлы с хешем в имени кэшируются надолго, остальное — на index.html.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
