{
  "name": "@korgool/server",
  "version": "0.1.0",
  "private": true,
  "description": "Игровой сервер: Fastify + Socket.IO, партии онлайн, серверные часы.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --external:bufferutil --external:utf-8-validate --external:@electric-sql/pglite --external:drizzle-orm/pglite --external:drizzle-orm/pglite/* \"--banner:js=import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@korgool/engine": "workspace:*",
    "@korgool/protocol": "workspace:*",
    "@sentry/node": "^11.4.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
